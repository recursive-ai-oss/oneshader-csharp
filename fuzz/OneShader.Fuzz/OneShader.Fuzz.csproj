<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fuzz targets. SharpFuzz is allowed here only: it instruments for libFuzzer/AFL and is never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneShader/OneShader.csproj" />
  </ItemGroup>
</Project>

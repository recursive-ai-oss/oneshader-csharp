<Project>
  <!-- Package identity and version: the only place they are defined. -->
  <PropertyGroup>
    <OneShaderVersion>0.3.0-dev</OneShaderVersion>
    <OneShaderLibraryPackageId>RecursiveAI.OneShader</OneShaderLibraryPackageId>
    <OneShaderBuildPackageId>RecursiveAI.OneShader.Build</OneShaderBuildPackageId>
    <RootNamespace>OneShader</RootNamespace>
    <Version>$(OneShaderVersion)</Version>
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright © Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Build output location. Order: an /p:OneShaderArtifacts=... argument, then the
    ONESHADER_ARTIFACTS environment variable, then .artifacts next to this file. Point the
    variable outside the tree to keep build output away from the sources; a fresh clone needs
    nothing set.
  -->
  <PropertyGroup>
    <OneShaderArtifacts Condition="'$(OneShaderArtifacts)' == ''">$(ONESHADER_ARTIFACTS)</OneShaderArtifacts>
    <OneShaderArtifacts Condition="'$(OneShaderArtifacts)' == ''">$(MSBuildThisFileDirectory).artifacts</OneShaderArtifacts>
    <ArtifactsPath>$(OneShaderArtifacts)</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- The compiler and runtime API. Depends on the shared framework only: no PackageReference. -->
  <PropertyGroup>
    <AssemblyName>OneShader</AssemblyName>
    <PackageId>$(OneShaderLibraryPackageId)</PackageId>
    <Description>A HLSL compiler for .NET written in C# with no dependencies: vertex, pixel and compute shaders to SPIR-V for Vulkan, with reflection. Runtime compiler and the support types used by RecursiveAI.OneShader.Build.</Description>
    <PackageTags>hlsl;shader;shaders;spirv;vulkan;compiler;gpu;reflection</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <!-- Symbols ship as a separate .snupkg. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="OneShader.Tests" />
    <InternalsVisibleTo Include="OneShader.Fuzz" />
  </ItemGroup>
</Project>

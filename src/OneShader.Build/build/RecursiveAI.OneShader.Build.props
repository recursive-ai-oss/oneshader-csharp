<Project>
  <PropertyGroup>
    <!-- A project can point this at a locally built task assembly instead of the packaged one. -->
    <OneShaderTaskAssembly Condition="'$(OneShaderTaskAssembly)' == ''">$(MSBuildThisFileDirectory)../tasks/net10.0/OneShader.Build.Tasks.dll</OneShaderTaskAssembly>
  </PropertyGroup>
</Project>

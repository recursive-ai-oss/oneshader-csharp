<Project>
  <!--
    Compiles every OneShader item before the C# compiler runs and passes the results to the
    source generator as additional files.

    Item metadata (all optional):
      EntryPoints         Name:Stage;Name:Stage  - instead of finding [shader("...")] attributes
      Defines             NAME;NAME=value        - preprocessor definitions
      IncludeDirectories  dir;dir                - searched for #include after the including file's folder
      Targets             SpirV;Msl;Wgsl         - overrides $(OneShaderTargets) for this file
      Enable16BitTypes    true|false - half, min16* and int16_t are native 16-bit types (overrides $(OneShaderEnable16BitTypes))
      DebugInfo           true|full|lines|false   - source-level debug information in the embedded blobs (overrides $(OneShaderDebugInfo))
      Optimize            true|false - false compiles without the optimizer (overrides $(OneShaderOptimize))
      Namespace           overrides $(OneShaderNamespace) for this file
      ClassName           overrides the class name taken from the file name
      Axes                NAME;NAME=A|B|C        - keyword axes; every combination is compiled as a variant (see below)
      MaxVariants         largest number of variants for this file (default $(OneShaderMaxVariants), then 64)

    Project properties:
      EnableDefaultOneShaderItems  false stops **/*.hlsl from being added as OneShader items
      OneShaderNamespace           default namespace of generated code (default: $(RootNamespace).Shaders)
      OneShaderTargets             targets to compile and embed, ';'-separated: SpirV, Msl, Wgsl (default: SpirV)
      OneShaderEnable16BitTypes    true: half/min16*/int16_t family are native 16-bit types, as DXC's -enable-16bit-types (default: false)
      OneShaderDebugInfo           true|full: NonSemantic.Shader.DebugInfo.100 in SPIR-V and #line in MSL (RenderDoc, Nsight, Xcode);
                                   lines: OpSource/OpLine only; false (default): none. Paths in the blobs are project-relative.
                                   Typical use: <OneShaderDebugInfo Condition="'$(Configuration)' == 'Debug'">true</OneShaderDebugInfo>
      OneShaderOptimize            false: no optimizer, best stepping (default: true)
      OneShaderDefines, OneShaderIncludeDirectories  applied to every shader
      OneShaderMaxVariants         default for the MaxVariants metadata

    Variants. Keyword axes on the item:
      <OneShader Include="Shaders/Sprite.hlsl" Axes="ALPHA_TEST;LIGHTING=NONE|LAMBERT|PBR" />
    compile 2 x 3 = 6 variants (a bare NAME is a flag: defined as 1 or not defined; NAME=A|B|C defines NAME as the
    value and NAME_VALUE as 1). Hand-picked define sets are OneShaderVariant items that name their shader:
      <OneShaderVariant Include="Cutout" Shader="Shaders/Sprite.hlsl" Defines="ALPHA_TEST=1" />
  -->
  <UsingTask TaskName="OneShader.Build.Tasks.CompileShaders" AssemblyFile="$(OneShaderTaskAssembly)" />

  <PropertyGroup>
    <EnableDefaultOneShaderItems Condition="'$(EnableDefaultOneShaderItems)' == ''">true</EnableDefaultOneShaderItems>
    <OneShaderNamespace Condition="'$(OneShaderNamespace)' == ''">$(RootNamespace).Shaders</OneShaderNamespace>
    <OneShaderTargets Condition="'$(OneShaderTargets)' == ''">SpirV</OneShaderTargets>
    <OneShaderOutputDirectory Condition="'$(OneShaderOutputDirectory)' == ''">$(IntermediateOutputPath)oneshader/</OneShaderOutputDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableDefaultOneShaderItems)' == 'true'">
    <!-- Files the project already lists (to give them metadata) are not added a second time. -->
    <OneShader Include="**/*.hlsl" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);@(OneShader)" />
  </ItemGroup>

  <Target Name="OneShaderCompile" BeforeTargets="CoreCompile" Condition="'@(OneShader)' != ''">
    <CompileShaders Shaders="@(OneShader)"
                    OutputDirectory="$(OneShaderOutputDirectory)"
                    ProjectDirectory="$(MSBuildProjectDirectory)"
                    DefaultNamespace="$(OneShaderNamespace)"
                    DefaultTargets="$(OneShaderTargets)"
                    DefaultEnable16BitTypes="$(OneShaderEnable16BitTypes)"
                    DefaultDebugInfo="$(OneShaderDebugInfo)"
                    DefaultOptimize="$(OneShaderOptimize)"
                    DefaultDefines="$(OneShaderDefines)"
                    DefaultIncludeDirectories="$(OneShaderIncludeDirectories)"
                    Variants="@(OneShaderVariant)"
                    DefaultMaxVariants="$(OneShaderMaxVariants)">
      <Output TaskParameter="GeneratedFiles" ItemName="_OneShaderOutput" />
    </CompileShaders>
    <ItemGroup>
      <AdditionalFiles Include="@(_OneShaderOutput)" />
      <FileWrites Include="@(_OneShaderOutput)" />
    </ItemGroup>
  </Target>
</Project>

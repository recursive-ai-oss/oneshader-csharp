<Project Sdk="Microsoft.NET.Sdk">
  <!-- A one-shot command-line wrapper around ShaderCompiler.CompileFile, built only so the benchmark can time whole
       processes next to DXC. Published twice: as a normal (JIT) build and with NativeAOT. Not packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>oshc</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneShader/OneShader.csproj" />
  </ItemGroup>
</Project>

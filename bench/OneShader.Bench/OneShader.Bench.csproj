<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-time benchmarks: in-process (BenchmarkDotNet) and whole-process against DXC. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OneShader.Bench</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneShader/OneShader.csproj" />
  </ItemGroup>
</Project>

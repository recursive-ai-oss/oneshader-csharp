# 100 float4 values transformed by a kernel configured through a struct-typed push-constant global (64 bytes).
case push_kernel
shader compute/push_kernel.hlsl
dispatch CSMain 2 1 1
storage 0 0 : @f01(7,400)
storage 0 1 out size=2048
# Count, Scale, 8 bytes padding, Offset, Mode, Bias, 8 bytes padding, Mul.
push : 100u 1.5 0.0 0.0  0.25 -0.5 0.75 1u  0.125 -0.25 0.0 0.0  2.0 0.5 -1.0 4.0
expect push_kernel

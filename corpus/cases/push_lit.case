# A sphere drawn with per-draw values from a push-constant block shared by the vertex and pixel stages:
# model matrix, tint, palette index, light direction, uv scale and two stripe weights (112 bytes).
case push_lit
shader 3d/push_lit.hlsl
graphics vs=VSMain ps=PSMain
target 128 128 background=solid(0.05,0.05,0.08,1.0)
depth
cull back
tolerance 1
vertexbuffer 0 48 : @sphere(24,24,0.7)
attr 0 float3 0
attr 1 float3 12
attr 2 float2 24
index u32 : @sphereindex(24,24)
draw indexed=3456
uniform 0 0 : @viewproj(0,0.3,3.0,0,0,0,50,1,0.1,50,row)
storage 0 1 : 0.2 0.2 0.2 1.0  0.9 0.5 0.3 1.0  0.3 0.8 0.5 1.0  0.4 0.5 0.95 1.0
push : @world(0.1,-0.05,0,1.0,25,col) 1.0 0.9 0.8 0.9 2u -0.4 -0.7 -0.5 2.0 1.0 0.5 1.0

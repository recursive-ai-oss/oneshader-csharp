# A work list of 56 items of which 48 are drained (by 64 threads, 16 masked off) into a result list; the counters end at 8 and at the number of even values.
case append_consume
shader compute/append_consume.hlsl
dispatch CSMain 1 1 1
storage 0 0 : @u32(5,128)
storage 0 1 out : 56u
storage 0 2 out sorted size=512
storage 0 3 out : 0u
uniform 0 4 : 48u 0u 0u 0u
storage 0 5 out size=16

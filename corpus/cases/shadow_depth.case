# Depth-only pass: five instanced cubes seen from straight above through an orthographic light
# camera; the depth buffer is read back and compared.
case shadow_depth
shader 3d/shadow_depth.hlsl
graphics vs=VSMain
target 64 64
depth out
ftolerance 0.00001
vertexbuffer 0 48 : @cube(0.5)
attr 0 float3 0
index u32 : @cubeindex()
draw indexed=36 instances=5
uniform 0 0 : @orthoviewproj(0,6,0,0,0,0,4.0,0.5,12.0,row) 1.0
storage 0 1 :
  @world(-2.0,0.0,-1.0,1.0,10,col)
  @world(0.0,0.5,0.0,1.5,30,col)
  @world(1.8,-0.5,1.2,1.0,60,col)
  @world(-1.2,0.2,1.6,0.8,80,col)
  @world(1.5,0.8,-1.5,0.7,15,col)

# 256 particles (struct of 48 bytes) integrated for three steps of 0.1 s.
# (float=1e-5: WGSL implementations may fuse multiply-adds, which the WebGPU parity run tolerates.)
case particles
shader compute/particles.hlsl
dispatch CSMain 4 1 1
dispatch CSMain 4 1 1
dispatch CSMain 4 1 1
uniform 0 0 : 0.1 256u 1.0 1.0
storage 0 1 out float=1e-5 : @f01(11,3072)
expect particles

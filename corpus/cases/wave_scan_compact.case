# Group-wide exclusive scan and stream compaction from wave prefix sums and bit counts: 4 groups of 256 values, kept when divisible by 3.
case wave_scan_compact
shader compute/wave_scan_compact.hlsl
dispatch CSMain 4 1 1
storage 0 0 : @u32(7,1024,1000)
storage 0 1 out size=4096
storage 0 2 out size=16
storage 0 3 out size=4096
storage 0 4 out size=16
expect wave_scan_compact

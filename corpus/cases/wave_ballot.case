# Votes, ballots, lane queries and lane reads. Buffer 1 holds per-group totals that do not depend on the subgroup size and is
# checked against a CPU result; buffer 2 holds what each lane saw and is compared with DXC's build on the same device.
case wave_ballot
shader compute/wave_ballot.hlsl
dispatch CSMain 4 1 1
storage 0 0 : @u32(13,1024,1000)
storage 0 1 out size=128
storage 0 2 out size=16384
expect wave_ballot

# Batched sprites: three quads sharing one atlas, tinted, one half transparent.
case sprite
shader 2d/sprite.hlsl
graphics vs=VSMain ps=PSMain
target 128 128 background=checker(8)
blend premul
tolerance 1
vertexbuffer 0 20 :
  8.0 8.0 0.0 0.0 0xFFFFFFFFu    56.0 8.0 1.0 0.0 0xFFFFFFFFu
  8.0 56.0 0.0 1.0 0xFFFFFFFFu   56.0 56.0 1.0 1.0 0xFFFFFFFFu
  40.0 40.0 0.0 0.0 0xFF40C0FFu  104.0 40.0 0.5 0.0 0xFF40C0FFu
  40.0 88.0 0.0 0.5 0xFF40C0FFu  104.0 88.0 0.5 0.5 0xFF40C0FFu
  64.0 16.0 0.5 0.5 0x99FFFFFFu  120.0 16.0 1.0 0.5 0x99FFFFFFu
  64.0 72.0 0.5 1.0 0x99FFFFFFu  120.0 72.0 1.0 1.0 0x99FFFFFFu
attr 0 float2 0
attr 1 float2 8
attr 2 unorm8x4 16
index u16 : @quadindex(3)
draw indexed=18

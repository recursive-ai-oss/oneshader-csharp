# Pinned reference tools: the one place their versions and checksums live.
# They are released binaries used as black-box test oracles, never linked or redistributed.

# DirectX Shader Compiler, Linux x64 release (used with -spirv).
DXC_VERSION=v1.9.2609
DXC_URL=https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.9.2609/linux_dxc_2026_09_28.x86_x64.tar.gz
DXC_SHA256=96faadc7f5c282d2ffda49804beb4c3ee38127bc252b723234e3c5cdf7aa39a1

# SPIRV-Tools (spirv-val, spirv-dis, spirv-as, spirv-opt) as shipped in the LunarG Vulkan SDK
# Linux x64 tarball.
VULKAN_SDK_VERSION=1.4.363.0
VULKAN_SDK_URL=https://sdk.lunarg.com/sdk/download/1.4.363.0/linux/vulkan_sdk.tar.xz
VULKAN_SDK_SHA256=197962f5cbf80baf2775a03336a01cee7c8745686c65aaa70d3f751ade4d7e43

# SPIRV-Tools from the LunarG Vulkan SDK for macOS (universal binaries). The zip holds a command-line
# capable installer, which is run into a scratch directory; only the SPIRV-Tools executables are kept.
# Same SDK version as the Linux tarball. There is no macOS DXC release at DXC_VERSION.
VULKAN_SDK_MACOS_URL=https://sdk.lunarg.com/sdk/download/1.4.363.0/mac/vulkan_sdk.zip
VULKAN_SDK_MACOS_SHA256=163431e0203c8215286a17cf393643ce6b951f77d1b4f74ab30821a1f0beb09b

# DirectX Shader Compiler, Windows release (zip with x64, arm64 and x86 builds; the x64 ones are used).
DXC_WINDOWS_URL=https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.9.2609/dxc_2026_09_29.zip
DXC_WINDOWS_SHA256=ad31b1fc8443175d204f77a611fdb3ef2ec42759bdc2f1167368de24a4a7e7f1

# SPIRV-Tools from the LunarG Vulkan SDK for Windows x64. The installer runs headless into a scratch
# directory (copy only: no registry entries); only the SPIRV-Tools executables are kept.
VULKAN_SDK_WINDOWS_URL=https://sdk.lunarg.com/sdk/download/1.4.363.0/windows/vulkan_sdk.exe
VULKAN_SDK_WINDOWS_SHA256=94a82d378f7a5e3e54c9db7d2fb7016af136e14ac0a18dbf0f2f67a36352d141

# naga command-line validator (WGSL), built from the published crate with cargo (crates.io checks the crate checksum under --locked).
NAGA_VERSION=30.0.1

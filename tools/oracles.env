# Pinned reference tools: the one place their versions and checksums live.
# They are released binaries used as black-box test oracles, never linked or redistributed.

# DirectX Shader Compiler, Linux x64 release (used with -spirv).
DXC_VERSION=v1.9.2609
DXC_URL=https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.9.2609/linux_dxc_2026_09_28.x86_x64.tar.gz
DXC_SHA256=96faadc7f5c282d2ffda49804beb4c3ee38127bc252b723234e3c5cdf7aa39a1

# SPIRV-Tools (spirv-val, spirv-dis, spirv-as, spirv-opt) as shipped in the LunarG Vulkan SDK
# Linux x64 tarball.
VULKAN_SDK_VERSION=1.4.363.0
VULKAN_SDK_URL=https://sdk.lunarg.com/sdk/download/1.4.363.0/linux/vulkan_sdk.tar.xz
VULKAN_SDK_SHA256=197962f5cbf80baf2775a03336a01cee7c8745686c65aaa70d3f751ade4d7e43

# naga command-line validator (WGSL), built from the published crate with cargo (crates.io checks the crate checksum under --locked).
NAGA_VERSION=30.0.1
